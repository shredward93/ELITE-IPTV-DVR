<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.elitedvr" version="1.0.0" name="ELITE IPTV DVR" provider-name="ELITE">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.27.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">ELITE IPTV DVR</summary>
        <description lang="en">Premium IPTV streaming with DVR capabilities. Connects to your ELITE DVR server.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
