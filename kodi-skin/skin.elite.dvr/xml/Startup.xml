<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>10</defaultcontrol>
    <controls>
        
        <!-- Black Background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
        </control>
        
        <!-- Logo Animation Group -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>400</width>
            <height>400</height>
            
            <!-- Gold Circle Background -->
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>200</width>
                <height>200</height>
                <texture colordiffuse="FFF89344">circle.png</texture>
                <animation effect="fade" start="0" end="100" time="800" tween="sine" easing="inout">WindowOpen</animation>
                <animation effect="zoom" start="0" end="100" center="auto" time="800" tween="back" easing="out">WindowOpen</animation>
            </control>
            
            <!-- Logo -->
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>120</width>
                <height>120</height>
                <texture>elite_logo.png</texture>
                <animation effect="fade" start="0" end="100" delay="400" time="600">WindowOpen</animation>
            </control>
            
            <!-- Brand Text -->
            <control type="label">
                <centerleft>50%</centerleft>
                <top>280</top>
                <width>400</width>
                <height>40</height>
                <align>center</align>
                <label>ELITE IPTV DVR</label>
                <font>font28_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <animation effect="fade" start="0" end="100" delay="800" time="600">WindowOpen</animation>
            </control>
            
            <!-- Tagline -->
            <control type="label">
                <centerleft>50%</centerleft>
                <top>330</top>
                <width>400</width>
                <height>25</height>
                <align>center</align>
                <label>Premium Streaming Experience</label>
                <font>font12_caption</font>
                <textcolor>FFF89344</textcolor>
                <animation effect="fade" start="0" end="100" delay="1000" time="400">WindowOpen</animation>
            </control>
            
        </control>
        
        <!-- Loading Indicator -->
        <control type="group">
            <centerleft>50%</centerleft>
            <top>750</top>
            <width>200</width>
            <height>50</height>
            
            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>200</width>
                <height>20</height>
                <align>center</align>
                <label>Loading...</label>
                <font>font12_caption</font>
                <textcolor>FF9A9A9A</textcolor>
            </control>
            
            <!-- Progress Dots -->
            <control type="image">
                <left>80</left>
                <top>30</top>
                <width>8</width>
                <height>8</height>
                <texture colordiffuse="FFF89344">circle.png</texture>
                <animation effect="fade" start="100" end="30" time="600" condition="true" pulse="true">Conditional</animation>
            </control>
            <control type="image">
                <left>96</left>
                <top>30</top>
                <width>8</width>
                <height>8</height>
                <texture colordiffuse="FFF89344">circle.png</texture>
                <animation effect="fade" start="100" end="30" time="600" delay="200" condition="true" pulse="true">Conditional</animation>
            </control>
            <control type="image">
                <left>112</left>
                <top>30</top>
                <width>8</width>
                <height>8</height>
                <texture colordiffuse="FFF89344">circle.png</texture>
                <animation effect="fade" start="100" end="30" time="600" delay="400" condition="true" pulse="true">Conditional</animation>
            </control>
        </control>
        
    </controls>
</window>
