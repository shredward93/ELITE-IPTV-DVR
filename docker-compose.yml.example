# Docker Compose for ELITE IPTV DVR on Synology NAS
# Copy this file to docker-compose.yml and fill in your credentials
# IMPORTANT: Never commit docker-compose.yml with real credentials to Git!

version: "3.8"

services:
  elite-iptv-dvr:
    build: .
    container_name: elite-iptv-dvr
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      # REQUIRED: Your IPTV provider credentials
      SERVER_URL: "https://your-provider.com"
      USERNAME: "your_username"
      PASSWORD: "your_password"
      
      # Tunnel provider: cloudflare or instatunnel
      TUNNEL_PROVIDER: "cloudflare"
      
      # For InstaTunnel:
      # INSTATUNNEL_API_KEY: "your_key"
      # INSTATUNNEL_SUBDOMAIN: "your_subdomain"
      
      # For Cloudflare Tunnel:
      CLOUDFLARE_TUNNEL_TOKEN: "your_token_here"
      CLOUDFLARE_DOMAIN: "your.domain.com"
      
      # Storage location
      RECORDINGS_DIR: "/app/recordings"
      
      # Prevent Python from caching bytecode (fixes update issues)
      PYTHONDONTWRITEBYTECODE: "1"
    volumes:
      # Mount recordings folder on NAS
      - ./recordings:/app/recordings
      # Optional: Mount credentials from file instead of env vars
      # - ./credentials.json:/app/credentials.json:ro
      # Persist scheduled recordings
      - ./data:/app/data
      # Mount source code for live updates (no rebuild needed)
      - ./server_headless.py:/app/server_headless.py:ro
      - ./core:/app/core:ro
      - ./static:/app/static:ro
      - ./requirements.txt:/app/requirements.txt:ro
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/info"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
