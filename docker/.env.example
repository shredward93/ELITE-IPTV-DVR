# ELITE IPTV DVR - Environment Configuration
# Copy this file to .env and fill in your values

# Web Server
WEB_PORT=8080

# Storage Paths (adjust for your NAS)
RECORDINGS_PATH=/volume1/recordings
DATA_PATH=./data
LOGS_PATH=./logs

# DVR Settings
DVR_MAX_HOURS=6
DVR_MAX_GB=50

# XtreamCodes IPTV Provider Credentials
SERVER_URL=http://your-provider.com:8080
USERNAME=your_username
PASSWORD=your_password

# Cloudflare Tunnel (optional - for public access)
# Set to "cloudflare" to enable, leave blank for local-only
TUNNEL_PROVIDER=
CLOUDFLARE_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
