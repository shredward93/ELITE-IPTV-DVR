<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="10101">
    <defaultcontrol always="true">10</defaultcontrol>
    <coordinates>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        <!-- Dark Overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg_overlay">white.png</texture>
        </control>

        <!-- Dialog Panel -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>600</width>
            <height>250</height>

            <!-- Background -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>600</width>
                <height>250</height>
                <texture colordiffuse="bg_panel" border="18">white.png</texture>
            </control>

            <!-- Title -->
            <control type="label" id="1">
                <left>30</left>
                <top>20</top>
                <width>540</width>
                <height>30</height>
                <font>font22_header</font>
                <textcolor>elite_accent</textcolor>
            </control>

            <!-- Progress Line 1 -->
            <control type="label" id="9">
                <left>30</left>
                <top>65</top>
                <width>540</width>
                <height>25</height>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
            </control>

            <!-- Progress Line 2 -->
            <control type="label" id="10">
                <left>30</left>
                <top>90</top>
                <width>540</width>
                <height>25</height>
                <font>font12_caption</font>
