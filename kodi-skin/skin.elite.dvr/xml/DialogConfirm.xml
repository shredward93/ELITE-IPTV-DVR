<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="10100">
    <defaultcontrol always="true">11</defaultcontrol>
    <coordinates>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        
        <!-- Dark Overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg_overlay">white.png</texture>
        </control>
        
        <!-- Dialog Panel -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>600</width>
            <height>300</height>
            
            <!-- Background -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>600</width>
                <height>300</height>
                <texture colordiffuse="bg_panel" border="18">panel_rounded.png</texture>
            </control>
            
            <!-- Title -->
            <control type="label" id="1">
                <left>30</left>
                <top>25</top>
                <width>540</width>
                <height>30</height>
                <font>font22_header</font>
                <textcolor>elite_accent</textcolor>
            </control>
            
            <!-- Message -->
            <control type="label" id="9">
                <left>30</left>
                <top>80</top>
                <width>540</width>
                <height>100</height>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
                <align>center</align>
                <wrapmultiline>true</wrapmultiline>
            </control>
            
            <!-- Progress Bar (if used) -->
            <control type="progress" id="20">
                <left>50</left>
                <top>180</top>
                <width>500</width>
                <height>20</height>
                <texturebg colordiffuse="bg_card">white.png</texturebg>
                <lefttexture>-</lefttexture>
                <midtexture colordiffuse="elite_accent">white.png</midtexture>
                <righttexture>-</righttexture>
            </control>
            
            <!-- Button Group -->
            <control type="grouplist" id="11">
                <centerleft>50%</centerleft>
                <top>220</top>
                <width>500</width>
                <height>60</height>
                <itemgap>20</itemgap>
                <align>center</align>
                <orientation>horizontal</orientation>
                <onup>11</onup>
                <ondown>11</ondown>
                <onleft>11</onleft>
                <onright>11</onright>
            </control>
            
            <!-- No Button -->
            <control type="button" id="10">
                <description>No</description>
                <width>120</width>
                <height>44</height>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
                <focusedcolor>text_primary</focusedcolor>
                <texturefocus colordiffuse="bg_card_hover" border="22">button_rounded.png</texturefocus>
                <texturenofocus colordiffuse="bg_card" border="22">button_rounded.png</texturenofocus>
            </control>
            
            <!-- Yes Button -->
            <control type="button" id="12">
                <description>Yes</description>
                <width>120</width>
                <height>44</height>
                <font>font14_accent</font>
                <textcolor>text_primary</textcolor>
                <focusedcolor>text_primary</focusedcolor>
                <texturefocus colordiffuse="elite_accent" border="22">button_rounded.png</texturefocus>
                <texturenofocus colordiffuse="elite_accent_dark" border="22">button_rounded.png</texturenofocus>
            </control>
            
        </control>
    </controls>
</window>
