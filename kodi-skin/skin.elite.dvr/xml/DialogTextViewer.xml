<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="10147">
    <defaultcontrol always="true">5</defaultcontrol>
    <coordinates>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        <!-- Dark Overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="bg_overlay">white.png</texture>
        </control>

        <!-- Dialog Panel -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>900</width>
            <height>700</height>

            <!-- Background -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>900</width>
                <height>700</height>
                <texture colordiffuse="bg_panel" border="18">white.png</texture>
            </control>

            <!-- Title -->
            <control type="label" id="1">
                <left>30</left>
                <top>20</top>
                <width>840</width>
                <height>35</height>
                <font>font22_header</font>
                <textcolor>elite_accent</textcolor>
            </control>

            <!-- Text Area -->
            <control type="textbox" id="5">
                <left>30</left>
                <top>70</top>
                <width>840</width>
                <height>560</height>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
                <pagecontrol>60</pagecontrol>
            </control>

            <!-- Scrollbar -->
            <control type="scrollbar" id="60">
                <left>870</left>
                <top>70</top>
                <width>15</width>
                <height>560</height>
                <texturesliderbackground colordiffuse="bg_card">white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="elite_accent">white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="elite_accent_light">white.png</texturesliderbarfocus>
                <textureslidernib>-</textureslidernib>
                <textureslidernibfocus>-</textureslidernibfocus>
                <orientation>vertical</orientation>
            </control>

            <!-- Close Button -->
            <control type="button" id="7">
                <left>380</left>
                <top>645</top>
                <width>140</width>
                <height>40</height>
                <label>$LOCALIZE[222]</label>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
                <focusedcolor>text_primary</focusedcolor>
                <texturefocus colordiffuse="elite_accent" border="20">white.png</texturefocus>
                <texturenofocus colordiffuse="bg_card" border="20">white.png</texturenofocus>
                <onup>5</onup>
            </control>
        </control>
    </controls>
</window>
