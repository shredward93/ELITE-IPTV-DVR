            </control>

            <!-- Progress Bar -->
            <control type="progress" id="20">
                <left>30</left>
                <top>130</top>
                <width>540</width>
                <height>12</height>
                <texturebg colordiffuse="bg_card">white.png</texturebg>
                <lefttexture>-</lefttexture>
                <midtexture colordiffuse="elite_accent">white.png</midtexture>
                <righttexture>-</righttexture>
            </control>

            <!-- Cancel Button -->
            <control type="button" id="10">
                <left>230</left>
                <top>160</top>
                <width>140</width>
                <height>40</height>
                <label>$LOCALIZE[222]</label>
                <font>font14_label</font>
                <textcolor>text_secondary</textcolor>
                <focusedcolor>text_primary</focusedcolor>
                <texturefocus colordiffuse="elite_accent" border="20">white.png</texturefocus>
                <texturenofocus colordiffuse="bg_card" border="20">white.png</texturenofocus>
            </control>
        </control>
    </controls>
</window>
